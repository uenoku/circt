#!/usr/bin/env bash
set -euo pipefail

CIRCT_LEC="${CIRCT_LEC:-circt-lec}"
Z3="${Z3:-z3}"

# Filter out --shared-libs and its argument; check for --emit-smtlib.
args=()
emit_smtlib=false
for arg in "$@"; do
  [[ "$arg" == "--emit-smtlib" ]] && emit_smtlib=true
  [[ "$arg" == --shared-libs* ]] && continue
  args+=("$arg")
done

if $emit_smtlib; then
  exec "$CIRCT_LEC" "${args[@]}"
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

"$CIRCT_LEC" "${args[@]}" --emit-smtlib -o "$tmp"
z3 "$tmp" | grep -q "unsat"
