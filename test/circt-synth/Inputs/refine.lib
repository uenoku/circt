  cell (mydff) {
    area : 10.0;
    ff ("IQ", "IQN") {
      clocked_on: "CLK";
      next_state: "D";
    }
    pin (D) {
      direction: input;
      capacitance : 0.001;
    }
    pin (CLK) {
      direction: input;
      clock : true;
      capacitance : 0.001;
    }
    pin (Q) {
      direction: output;
      function: "IQ";
    }
  }
