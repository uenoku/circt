library(retrytest) {
  lu_table_template (t1) {
    variable_1: input_net_transition;
    variable_2: total_output_net_capacitance;
    index_1 ("0.01, 0.02");
    index_2 ("0.001, 0.002");
  }
  cell (myand2) {
    area : 4.0;
    pin (A) {
      direction: input;
      capacitance : 0.001;
    }
    pin (B) {
      direction: input;
      capacitance : 0.002;
    }
    pin (X) {
      direction: output;
      function: "A * B";
      timing () {
        related_pin: "A";
        timing_sense: positive_unate;
        timing_type: combinational;
        cell_rise (t1) {
          values ("0.1, 0.2", "0.3, 0.4");
        }
        cell_fall (t1) {
          values ("0.1, 0.2", "0.3, 0.4");
        }
        rise_transition (t1) {
          values ("0.1, 0.2", "0.3, 0.4");
        }
        fall_transition (t1) {
          values ("0.1, 0.2", "0.3, 0.4");
        }
      }
      timing () {
        related_pin: "B";
        timing_sense: positive_unate;
