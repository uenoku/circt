+// Function: report_endpoints
+// Enumerate every analyzed endpoint with arrival, required, and slack.
+// Backed by the same endpoint store as report_wns/report_tns/report_fep.
+std::vector<Timer::EndpointInfo> Timer::report_endpoints() {
+
+  std::scoped_lock lock(_mutex);
+
+  _update_endpoints();
+
+  std::vector<EndpointInfo> infos;
+
+  FOR_EACH_EL_RF(el, rf) {
+    for(auto& ept : _endpoints[el][rf]) {
+      EndpointInfo info;
+      info.split = el;
+      info.transition = rf;
+      info.slack = ept.slack();
+      if(auto test = ept.test()) {
+        info.pin = test->_arc._to._name;
+        info.arrival = test->_arc._to._at[el][rf];
+        info.required = test->_rat[el][rf];
+        auto tv = test->_arc.timing_view();
+        if(auto tm = tv[el]; tm && tm->type)
+          info.testType = to_string(*tm->type);
+      }
+      else if(auto po = ept.primary_output()) {
+        info.pin = po->_pin._name;
+        info.arrival = po->_pin._at[el][rf];
+        info.required = po->_rat[el][rf];
+        info.testType = "output";
+      }
+      else {
+        continue;
+      }
+      infos.push_back(std::move(info));
+    }
+  }
+
+  return infos;
+}
